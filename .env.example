# Copy to .env and set a real password. .env is git-ignored.
# If the password contains URL-special characters (@ : / # %), percent-encode
# it in DATABASE_URL.
POSTGRES_USER=ethel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=etheldb

# Used by the Diesel CLI and by `cargo run` on the host (db on localhost).
# docker compose builds its own URL for the app container from the values above.
DATABASE_URL=postgres://ethel:change-me@localhost:5432/etheldb

# Login password for the web app (at least 12 characters).
ETHEL_PASSWORD=change-me-to-a-long-password
# Encrypts session cookies. Required for release builds (Docker).
# Generate with: openssl rand -base64 32
# Changing it logs everyone out.
ROCKET_SECRET_KEY=
# Set to true when serving over HTTPS (e.g. behind a reverse proxy).
ETHEL_SECURE_COOKIE=false
