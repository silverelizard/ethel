# Copy to .env and set a real password. .env is git-ignored.
# If the password contains URL-special characters (@ : / # %), percent-encode
# it in DATABASE_URL.
POSTGRES_USER=ethel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=etheldb

# Used by the Diesel CLI and by `cargo run` on the host (db on localhost).
# docker compose builds its own URL for the app container from the values above.
DATABASE_URL=postgres://ethel:change-me@localhost:5432/etheldb
